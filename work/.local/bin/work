#!/usr/bin/env bash
# work -- a local, agent-readable view of the GitLab work you own.
#
#   work sync [--repo <path>]   fetch and rewrite the mirror (one GraphQL call per page)
#   work board                  the queue, bucketed by what is blocking it (no network)
#   work mr <iid>               one merge request, end to end: gates, pipeline, approvals
#   work ready                  the actionable rows only, one per line, for agents
#   work path                   print the mirror directory
#
# GitLab stays the source of truth. This only ever READS it: nothing here assigns,
# comments, closes or merges, so a stale mirror can mislead but never damage. The
# mirror is a full snapshot every sync - that is what makes deletions (an MR that
# merged, an issue that closed) disappear for free, with no cursor state to drift.
#
# Everything is derived, so the whole directory is disposable: delete it and re-sync.
# It lives outside any repo because MR bodies and comments can carry credentials, and
# a notes repo would commit them.
#
# Project comes from the git remote and identity from glab's own token, so this file
# holds no host, group, project or username - it works on any GitLab repo unchanged.
#
# "Can I merge this?" is answered by GitLab's own mergeabilityChecks, never inferred.
# detailedMergeStatus reports one blocker and is computed lazily (UNCHECKED for much
# of any real queue); mergeabilityChecks returns EVERY gate with its own state, so a
# merge request with three problems says so instead of revealing them one at a time.

set -uo pipefail

MIRROR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/work"
PAGE=50      # GraphQL page size; the loop follows hasNextPage, so this is only a batch size
MAX_PAGES=40 # backstop against an unbounded cursor loop
TITLE_MAX=52

trace() { "$HOME/.local/bin/dotfiles-trace" log work "$@" 2>/dev/null || true; }
die() {
    printf 'work: %s\n' "$*" >&2
    exit 1
}

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not on PATH"; }

# owner/name from the origin remote, for both ssh and https forms. Never hardcoded:
# that is what keeps this script free of any employer identifier.
#
# The host is checked against glab's own, because a remote on some OTHER forge still
# parses into a plausible owner/name: GitLab answers `project(fullPath:)` for an
# unknown path with a null rather than an error, which reads as "you have no work"
# and would overwrite a good mirror with an empty board.
project_path() {
    local dir=$1 url host want
    url=$(git -C "$dir" remote get-url origin 2>/dev/null) || return 1
    url=${url%.git}
    case "$url" in
        *://*)
            host=${url#*://}
            host=${host%%/*}
            host=${host#*@}
            printf '%s\n' "${url#*://*/}"
            ;;
        *:*)
            host=${url%%:*}
            host=${host#*@}
            printf '%s\n' "${url#*:}"
            ;;
        *) return 1 ;;
    esac
    want=$(glab config get host 2>/dev/null)
    [ -z "$want" ] || [ "$host" = "$want" ] || {
        printf 'work: %s is on %s, not %s (glab cannot see it)\n' "$dir" "$host" "$want" >&2
        return 1
    }
}

# ---------------------------------------------------------------- fetch

# reviewState answers "is anyone actually reviewing this" and approvalState.rules
# exposes which CODEOWNERS rule is unsatisfied - neither exists on the REST list,
# which is why this is GraphQL. The page size is small because these nested
# selections are heavy per node.
mr_query() {
    local proj=$1 who=$2 after=$3
    local cursor=''
    [ -n "$after" ] && cursor=", after: \"$after\""
    cat <<EOF
query {
  project(fullPath: "$proj") {
    mergeRequests(state: opened, authorUsername: "$who", first: $PAGE$cursor) {
      pageInfo { hasNextPage endCursor }
      nodes {
        iid title draft conflicts detailedMergeStatus
        approved approvalsRequired approvalsLeft
        resolvableDiscussionsCount resolvedDiscussionsCount
        sourceBranch targetBranch commitCount createdAt updatedAt webUrl
        diffStatsSummary { additions deletions fileCount }
        mergeabilityChecks { identifier status }
        headPipeline { status detailedStatus { label } stages { nodes { name status } } }
        approvalState { rules { name approvalsRequired approved approvedBy { nodes { username } } } }
        labels { nodes { title } }
        reviewers { nodes { username mergeRequestInteraction { reviewState } } }
      }
    }
  }
}
EOF
}

issue_query() {
    local proj=$1 who=$2 after=$3
    local cursor=''
    [ -n "$after" ] && cursor=", after: \"$after\""
    cat <<EOF
query {
  project(fullPath: "$proj") {
    issues(state: opened, authorUsername: "$who", first: $PAGE$cursor) {
      pageInfo { hasNextPage endCursor }
      nodes {
        iid title updatedAt webUrl
        labels { nodes { title } }
      }
    }
  }
}
EOF
}

# Walk the cursor and print one flat JSON array of nodes. A page that errors aborts
# the whole sync rather than writing a half-mirror that reads as complete.
fetch_all() {
    local kind=$1 proj=$2 who=$3
    local after='' page=0 out resp acc='[]' field more cur
    while [ "$page" -lt "$MAX_PAGES" ]; do
        case "$kind" in
            mrs) out=$(mr_query "$proj" "$who" "$after") ;;
            issues) out=$(issue_query "$proj" "$who" "$after") ;;
        esac
        resp=$(glab api graphql -f query="$out" 2>&1) || {
            printf 'work: %s fetch failed: %s\n' "$kind" "${resp:0:200}" >&2
            return 1
        }
        case "$resp" in *'"errors"'*)
            printf 'work: %s query rejected: %s\n' "$kind" "${resp:0:200}" >&2
            return 1
            ;;
        esac
        # A null project is not an empty project: GitLab returns it for a path that
        # does not exist or that this token cannot see. Treating it as zero rows would
        # replace a good mirror with a blank board and report success.
        [ "$(jq -r '.data.project | type' <<<"$resp")" = object ] || {
            printf 'work: %s not visible to this token (wrong project, or no access)\n' "$proj" >&2
            return 1
        }
        field=mergeRequests
        [ "$kind" = issues ] && field=issues
        acc=$(jq -c --argjson acc "$acc" --arg f "$field" \
            '$acc + (.data.project[$f].nodes // [])' <<<"$resp") || return 1
        more=$(jq -r --arg f "$field" '.data.project[$f].pageInfo.hasNextPage' <<<"$resp")
        cur=$(jq -r --arg f "$field" '.data.project[$f].pageInfo.endCursor' <<<"$resp")
        [ "$more" = true ] || break
        after=$cur
        page=$((page + 1))
    done
    printf '%s' "$acc"
}

# ---------------------------------------------------------------- shared jq

# Sourced into every render. INACTIVE means the gate is not configured on this
# project, so it is silence rather than a pass - only FAILED and CHECKING are worth
# a reader's attention.
JQ_LIB='
  def gate($id):
    {"CONFLICT": "conflicts with the target branch",
     "DISCUSSIONS_NOT_RESOLVED": "unresolved review threads",
     "NOT_APPROVED": "not enough approvals",
     "DRAFT_STATUS": "still marked draft",
     "CI_MUST_PASS": "pipeline must pass",
     "NEED_REBASE": "needs a rebase",
     "REQUESTED_CHANGES": "a reviewer requested changes",
     "MERGE_REQUEST_BLOCKED": "blocked by another merge request",
     "COMMITS_STATUS": "source branch has no mergeable commits",
     "NOT_OPEN": "not open",
     "LOCKED_PATHS": "touches locked paths",
     "LOCKED_LFS_FILES": "touches locked LFS files",
     "TITLE_REGEX": "title does not match the required pattern",
     "JIRA_ASSOCIATION_MISSING": "no linked jira issue",
     "STATUS_CHECKS_MUST_PASS": "external status checks must pass",
     "SECURITY_POLICY_VIOLATIONS": "security policy violations",
     "SECURITY_POLICY_PIPELINE_CHECK": "security policy pipeline check",
     "MERGE_TIME": "merge-after time has not passed"}[$id] // ($id | ascii_downcase);
  def blockers: [.mergeabilityChecks[]? | select(.status == "FAILED") | gate(.identifier)];
  def pending: [.mergeabilityChecks[]? | select(.status == "CHECKING") | gate(.identifier)];
  def ci: (.headPipeline.status // "NONE");
  def pipe: (.headPipeline.detailedStatus.label // "no pipeline");
  def threads: (.resolvableDiscussionsCount // 0) as $r
    | (.resolvedDiscussionsCount // 0) as $d
    | if $r == 0 then "" else "threads \($d)/\($r)" end;
  def revstate($s): if $s == "APPROVED" then "✓" elif $s == "REQUESTED_CHANGES" then "✗"
    elif $s == "REVIEWED" then "•" else "·" end;
  def revs: [.reviewers.nodes[]? | "\(.username) \(revstate(.mergeRequestInteraction.reviewState))"];
  def age: ((now - (.updatedAt | fromdateiso8601)) / 86400 | floor) as $d
    | if $d >= 1 then "\($d)d" else "today" end;
  def short($n): if (. | length) > $n then .[0:($n - 1)] + "…" else . end;
  # Buckets are ordered by who owns the next move: your own fixes first, then work
  # that no human has been asked to look at, then work genuinely waiting on someone.
  def bucket:
    if .draft then "draft"
    elif (blockers | any(. == "conflicts with the target branch")) then "blocked"
    elif ci == "FAILED" then "blocked"
    elif (blockers | any(. == "unresolved review threads")) then "blocked"
    elif ([.reviewers.nodes[]?] | length) == 0 then "unasked"
    elif (blockers | length) == 0 then "mergeable"
    else "review" end;
'

# ---------------------------------------------------------------- render

render_board() {
    local meta=$1 mrs=$2 issues=$3
    jq -r --slurpfile meta "$meta" --slurpfile iss "$issues" "$JQ_LIB"'
      def row: "!\(.iid)  \(.title | short('"$TITLE_MAX"'))";
      def prio: ([.labels.nodes[]?.title | select(startswith("prio::"))] | first // "");
      def bits($a): [$a[] | select(. != "")] | join("  ·  ");

      (map(. + {b: bucket})) as $all
      | ($all | map(select(.b == "unasked")) | sort_by(.updatedAt)) as $unasked
      | ($all | map(select(.b == "blocked")) | sort_by(.updatedAt)) as $blocked
      | ($all | map(select(.b == "review")) | sort_by(.updatedAt)) as $review
      | ($all | map(select(.b == "mergeable"))) as $ready
      | ($all | map(select(.b == "draft")) | sort_by(.updatedAt)) as $draft
      | ($iss[0] | map(select([.labels.nodes[]?.title] | index("prio::high")))) as $hot
      | [ "# Work board",
          "",
          "_\($meta[0].synced) · \($meta[0].project) · as \($meta[0].user)"
            + " · \($all | length) open MRs, \($iss[0] | length) open issues_",
          "",
          "Derived from GitLab by `work sync` - edits here are lost on the next sync.",
          "`work mr <iid>` for one merge request end to end.",
          "",
          "## ✅ Ready to merge (\($ready | length))",
          "",
          "Every gate GitLab checks is green. Nothing is stopping these.",
          ""]
        + ($ready | map("- \(row)  ·  \(pipe)  ·  approved "
            + "\(.approvalsRequired - .approvalsLeft)/\(.approvalsRequired)"))
        + ["",
           "## ⚠ Done, no reviewer assigned (\($unasked | length))",
           "",
           "Finished work nobody was asked to look at. Assign a reviewer and it starts moving.",
           ""]
        + ($unasked | map("- \(row)  ·  " + bits([age, pipe, (blockers | join(", "))])))
        + ["",
           "## Blocked on me (\($blocked | length))",
           "",
           "Yours to fix before anyone can review.",
           ""]
        + ($blocked | map("- \(row)  ·  " + bits([age, (blockers | join(", ")), threads])))
        + ["",
           "## In review (\($review | length))",
           ""]
        + ($review | map("- \(row)  ·  " + bits([(revs | join("  ")), threads, (blockers | join(", "))])))
        + ["",
           "## prio::high issues (\($hot | length))",
           "",
           "_GitLab serves issue→MR links one issue at a time, so this is not filtered to unstarted work._",
           ""]
        + ($hot | map("- #\(.iid)  \(.title | short('"$TITLE_MAX"'))"))
        + ["",
           "## Draft (\($draft | length))",
           ""]
        + ($draft | map("- \(row)  ·  " + bits([age, pipe])))
        | .[]
    ' "$mrs"
}

# Every merge request, end to end, as one marker-delimited stream that the caller
# splits into files. One jq process for the whole set: invoking it per MR re-parsed
# the entire snapshot 55 times and turned a 5-second sync into minutes.
MARK='<<<work-mr '
render_mrs() {
    local meta=$1 mrs=$2
    jq -r --slurpfile meta "$meta" --arg mark "$MARK" "$JQ_LIB"'
      .[]
      | ["\($mark)\(.iid)"]
        + [ "# !\(.iid)  \(.title)",
          "",
          "_\($meta[0].synced) · [open in gitlab](\(.webUrl))_",
          "",
          "| | |",
          "|---|---|",
          "| branch | `\(.sourceBranch)` → `\(.targetBranch)` |",
          "| size | \(.commitCount) commits, +\(.diffStatsSummary.additions)"
            + "/-\(.diffStatsSummary.deletions) in \(.diffStatsSummary.fileCount) files |",
          "| pipeline | \(pipe) |",
          "| updated | \(age) ago |",
          ""]
        + (if (blockers | length) == 0
           then ["## Can I merge it?  **Yes**", "", "Every gate GitLab checks is green."]
           else ["## Can I merge it?  **No - \(blockers | length) blocker(s)**", ""]
                + (blockers | map("- ✗ \(.)"))
                + (pending | map("- … \(.) (still checking)"))
           end)
        + ["",
           "## Pipeline",
           ""]
        + (if (.headPipeline == null) then ["No pipeline has run."]
           else ["| stage | status |", "|---|---|"]
                + [.headPipeline.stages.nodes[]? | "| \(.name) | \(.status | ascii_downcase) |"]
           end)
        + ["",
           "## Approvals  \(.approvalsRequired - .approvalsLeft) of \(.approvalsRequired)",
           "",
           "A rule met by nobody eligible is why an approval count can read as satisfied",
           "while GitLab still refuses the merge.",
           "",
           "| rule | required | met | approved by |",
           "|---|---|---|---|"]
        + [.approvalState.rules[]? |
            "| \(.name) | \(.approvalsRequired // 0) | \(if .approved then "yes" else "no" end) | "
            + (([.approvedBy.nodes[]?.username] | join(", ")) | if . == "" then "-" else . end) + " |"]
        + ["",
           "## Reviewers",
           ""]
        + (if ([.reviewers.nodes[]?] | length) == 0
           then ["**Nobody is assigned.** This will not move until someone is."]
           else ["| who | state |", "|---|---|"]
                + [.reviewers.nodes[] |
                    "| \(.username) | \(.mergeRequestInteraction.reviewState | ascii_downcase) |"]
           end)
        + ["",
           "## Threads",
           "",
           (if (.resolvableDiscussionsCount // 0) == 0 then "No review threads."
            else "\(.resolvedDiscussionsCount) of \(.resolvableDiscussionsCount) resolved." end)]
        | .[]
    ' "$mrs"
}

# The agent entry point: actionable rows only, one per line, no headings.
render_ready() {
    jq -r "$JQ_LIB"'
      map(. + {b: bucket})
      | map(select(.b == "blocked" or .b == "unasked" or .b == "mergeable"))
      | sort_by(.updatedAt)
      | .[]
      | "\(.b)\t!\(.iid)\t\((blockers | join(", ")) | if . == "" then "-" else . end)\t\(.title)"
    ' "$1"
}

# ---------------------------------------------------------------- commands

# Global, not local: the EXIT trap fires after cmd_sync has returned, and under
# `set -u` a trap referencing a dead local kills the script on its way out.
STAGE=''
cleanup() { [ -n "$STAGE" ] && rm -rf "$STAGE"; }

cmd_sync() {
    local dir=${1:-$PWD} proj who mrs issues tmp nm ni iid
    need glab
    need jq
    need git
    # project_path already said why on stderr; this only adds the way out.
    proj=$(project_path "$dir") || die "cannot resolve a gitlab project for $dir (pass --repo <path>)"
    who=$(glab api user 2>/dev/null | jq -r '.username // empty') ||
        die "cannot reach gitlab (is glab authenticated?)"
    [ -n "$who" ] || die "cannot reach gitlab (is glab authenticated?)"

    mrs=$(fetch_all mrs "$proj" "$who") || exit 1
    issues=$(fetch_all issues "$proj" "$who") || exit 1

    # Staged in a temp dir and moved into place, so a sync that dies halfway leaves
    # the previous mirror intact rather than a truncated one that still looks whole.
    tmp=$(mktemp -d) || die "cannot write a temp dir"
    STAGE=$tmp
    trap cleanup EXIT
    mkdir -p "$tmp/mr"
    printf '%s' "$mrs" >"$tmp/mrs.json"
    printf '%s' "$issues" >"$tmp/issues.json"
    jq -n --arg p "$proj" --arg u "$who" --arg s "$(date '+%Y-%m-%d %H:%M:%S')" \
        '{project: $p, user: $u, synced: $s}' >"$tmp/meta.json"
    render_board "$tmp/meta.json" "$tmp/mrs.json" "$tmp/issues.json" >"$tmp/board.md" ||
        die "board render failed"
    # Split the one stream on its markers. awk owns the file handles so the whole set
    # is written in a single pass, with no shell loop and no re-reading the snapshot.
    render_mrs "$tmp/meta.json" "$tmp/mrs.json" |
        awk -v dir="$tmp/mr" -v mark="$MARK" '
            index($0, mark) == 1 { f = dir "/" substr($0, length(mark) + 1) ".md"; next }
            f { print > f }
        ' || die "mr render failed"

    # mr/ is replaced wholesale, never merged into: a merge request that merged since
    # the last sync must leave, and that only happens if the old directory goes.
    mkdir -p "$MIRROR"
    rm -rf "$MIRROR/mr"
    mv "$tmp/mrs.json" "$tmp/issues.json" "$tmp/meta.json" "$tmp/board.md" "$tmp/mr" "$MIRROR/"

    nm=$(jq 'length' <<<"$mrs")
    ni=$(jq 'length' <<<"$issues")
    trace sync project="$proj" user="$who" mrs="$nm" issues="$ni" rc=0
    printf 'synced %s mrs, %s issues -> %s\n' "$nm" "$ni" "$MIRROR/board.md"
}

cmd_board() {
    [ -r "$MIRROR/board.md" ] || die "no mirror yet - run 'work sync'"
    cat "$MIRROR/board.md"
}

cmd_mr() {
    local iid=${1#!}
    [ -n "$iid" ] || die "usage: work mr <iid>"
    [ -r "$MIRROR/mr/$iid.md" ] || die "!$iid is not in the mirror (merged, closed, or not yours)"
    cat "$MIRROR/mr/$iid.md"
}

cmd_ready() {
    [ -r "$MIRROR/mrs.json" ] || die "no mirror yet - run 'work sync'"
    render_ready "$MIRROR/mrs.json"
}

usage() {
    sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-1}"
}

case "${1:-}" in
    sync)
        shift
        repo=$PWD
        case "${1:-}" in --repo)
            repo=${2:-}
            [ -n "$repo" ] || usage
            ;;
        esac
        cmd_sync "$repo"
        ;;
    board) cmd_board ;;
    mr)
        shift
        cmd_mr "${1:-}"
        ;;
    ready) cmd_ready ;;
    path) printf '%s\n' "$MIRROR" ;;
    -h | --help | help) usage 0 ;;
    *) usage ;;
esac
