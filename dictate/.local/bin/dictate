#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["faster-whisper", "evdev", "numpy"]
# ///
"""
dictate — toggle-key local speech-to-text for Wayland (GNOME), CPU-only.

A GNOME custom shortcut runs `dictate --toggle`: first press starts recording,
second press stops, transcribes locally with faster-whisper, and types the text
into the focused window via a synthetic uinput keyboard.

Security by design: the trigger is a GNOME shortcut, so nothing here ever reads
/dev/input — there is no keylogger surface and no `input` group. The only
elevated access is write to /dev/uinput (for typing), granted via a dedicated
`uinput` group. The mic opens only between toggle-on and toggle-off. Daemonless:
no resident process, no autostart.

Setup:
  dictate-setup            # one-time: dedicated 'uinput' group + udev rule (sudo)
  # log out / in, then:
  dictate --install-shortcut          # bind Ctrl+Alt+D to `dictate --toggle`
  dictate --check                     # verify uinput writable + parec present

Commands:
  dictate --toggle         # start/stop (bind this to a key; see --install-shortcut)
  dictate --check          # verify permissions/devices
  dictate --test           # record N s and print transcript (no sudo/uinput needed)
  dictate --install-shortcut [BINDING]   # default BINDING is <Ctrl><Alt>d

Config via env vars (all optional):
  DICTATE_MODEL    faster-whisper model          (default small.en)
  DICTATE_COMPUTE  ctranslate2 compute type      (default int8)
  DICTATE_LANG     language                      (default en)
  DICTATE_SOURCE   PipeWire/Pulse source name    (default: system default)
  DICTATE_PROMPT   initial_prompt to bias vocab  (default: coding terms)
  DICTATE_BEAM     beam size (1=fast, 5=accurate)(default 1)
  DICTATE_LATENCY  parec latency ms (low=prompt) (default 50)
  DICTATE_NOTIFY   desktop notifications 1/0     (default 1)
  DICTATE_TEST_SECS seconds to record in --test  (default 5)

Models: base.en (faster) · small.en (default, best balance) · distil-small.en
  (fast English) · large-v3-turbo (most accurate, slower on CPU; multilingual,
  so keep DICTATE_LANG=en).
"""
import os, sys, time, signal, shutil, subprocess

MODEL    = os.environ.get("DICTATE_MODEL", "small.en")
COMPUTE  = os.environ.get("DICTATE_COMPUTE", "int8")
LANG     = os.environ.get("DICTATE_LANG", "en")
SOURCE   = os.environ.get("DICTATE_SOURCE", "")
BEAM     = int(os.environ.get("DICTATE_BEAM", "1"))
LATENCY  = os.environ.get("DICTATE_LATENCY", "50")  # ms; low so parec flushes promptly
NOTIFY   = os.environ.get("DICTATE_NOTIFY", "1") == "1"
PROMPT   = os.environ.get(
    "DICTATE_PROMPT",
    "Dictation for a coding terminal. Terms: git, npm, Python, TypeScript, "
    "async, await, API, JSON, YAML, stdout, regex, Claude Code.",
)
RATE = 16000  # Whisper wants 16 kHz mono

RUNTIME   = os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/dictate-{os.getuid()}"
PCM_FILE  = os.path.join(RUNTIME, "dictate.pcm")
PID_FILE  = os.path.join(RUNTIME, "dictate.pid")


def log(*a):
    print("[dictate]", *a, file=sys.stderr, flush=True)


def notify(msg):
    # Best-effort desktop notification (the GNOME-shortcut path has no terminal).
    if not NOTIFY or not shutil.which("notify-send"):
        return
    try:
        subprocess.run(["notify-send", "-a", "dictate", "-t", "1500", "Dictate", msg],
                       check=False)
    except Exception:
        pass


# ---- typing via a synthetic uinput keyboard ------------------------------
import evdev
from evdev import UInput, ecodes as e


def build_keymap():  # US layout: char -> (keycode, needs_shift)
    m = {}
    for c in "abcdefghijklmnopqrstuvwxyz":
        kc = getattr(e, f"KEY_{c.upper()}")
        m[c] = (kc, False)
        m[c.upper()] = (kc, True)
    shifted_digits = ")!@#$%^&*("  # shift+0 .. shift+9
    for i, c in enumerate("0123456789"):
        kc = getattr(e, f"KEY_{c}")
        m[c] = (kc, False)
        m[shifted_digits[i]] = (kc, True)
    pairs = {
        " ": ("KEY_SPACE", False),      "\t": ("KEY_TAB", False),
        "-": ("KEY_MINUS", False),      "_": ("KEY_MINUS", True),
        "=": ("KEY_EQUAL", False),      "+": ("KEY_EQUAL", True),
        "[": ("KEY_LEFTBRACE", False),  "{": ("KEY_LEFTBRACE", True),
        "]": ("KEY_RIGHTBRACE", False), "}": ("KEY_RIGHTBRACE", True),
        "\\": ("KEY_BACKSLASH", False), "|": ("KEY_BACKSLASH", True),
        ";": ("KEY_SEMICOLON", False),  ":": ("KEY_SEMICOLON", True),
        "'": ("KEY_APOSTROPHE", False), '"': ("KEY_APOSTROPHE", True),
        "`": ("KEY_GRAVE", False),      "~": ("KEY_GRAVE", True),
        ",": ("KEY_COMMA", False),      "<": ("KEY_COMMA", True),
        ".": ("KEY_DOT", False),        ">": ("KEY_DOT", True),
        "/": ("KEY_SLASH", False),      "?": ("KEY_SLASH", True),
    }
    for c, (name, sh) in pairs.items():
        m[c] = (getattr(e, name), sh)
    return m


KEYMAP = build_keymap()

NORMALIZE = str.maketrans({  # chars Whisper emits that aren't on a US keyboard
    "’": "'", "‘": "'", "“": '"', "”": '"',
    "–": "-", "—": "-", " ": " ", "…": "...",
})


def open_uinput():
    keys = {e.KEY_LEFTSHIFT} | {kc for kc, _ in KEYMAP.values()}
    return UInput({e.EV_KEY: sorted(keys)}, name="dictate-virtual-kbd")


def type_text(ui, text):
    for ch in text:
        if ch == "\n":
            ch = " "  # never press Enter: it could submit the prompt
        km = KEYMAP.get(ch)
        if km is None:
            continue  # silently skip anything we can't map
        kc, shift = km
        if shift:
            ui.write(e.EV_KEY, e.KEY_LEFTSHIFT, 1); ui.syn()
        ui.write(e.EV_KEY, kc, 1); ui.syn()
        ui.write(e.EV_KEY, kc, 0); ui.syn()
        if shift:
            ui.write(e.EV_KEY, e.KEY_LEFTSHIFT, 0); ui.syn()
        time.sleep(0.004)  # let the compositor keep up


# ---- transcription -------------------------------------------------------
def load_model():
    log(f"loading model {MODEL!r} (first run downloads it)…")
    from faster_whisper import WhisperModel
    import numpy as np
    t0 = time.time()
    model = WhisperModel(MODEL, device="cpu", compute_type=COMPUTE)
    log(f"model ready in {time.time() - t0:.1f}s")
    return model, np


def transcribe(model, np, pcm):
    if len(pcm) < RATE * 2 * 0.3:  # < 0.3 s of audio
        return ""
    audio = np.frombuffer(pcm, dtype=np.int16).astype(np.float32) / 32768.0
    # condition_on_previous_text=False is the key anti-hallucination flag for
    # dictation; vad_filter + faster-whisper's default logprob/compression/
    # no_speech thresholds handle the rest.
    segments, _ = model.transcribe(
        audio, language=LANG, initial_prompt=PROMPT, beam_size=BEAM,
        vad_filter=True, condition_on_previous_text=False,
    )
    text = "".join(s.text for s in segments).translate(NORMALIZE)
    return " ".join(text.split())  # collapse all whitespace incl. newlines


def require_parec():
    if not shutil.which("parec"):
        log("parec not found (install pipewire-pulse / pulseaudio-utils)")
        sys.exit(1)


# ---- recording (detached parec -> temp file; daemonless toggle state) ----
def parec_cmd():
    cmd = ["parec", "--format=s16le", f"--rate={RATE}", "--channels=1",
           f"--latency-msec={LATENCY}"]
    if SOURCE:
        cmd.append(f"--device={SOURCE}")
    return cmd


def recording_pid():
    """Return the live parec pid if a recording is in progress, else None."""
    try:
        pid = int(open(PID_FILE).read().strip())
    except (OSError, ValueError):
        return None
    try:
        comm = open(f"/proc/{pid}/comm").read().strip()
    except OSError:
        _cleanup(); return None            # process gone -> stale state
    if comm != "parec":
        _cleanup(); return None            # pid reused by something else
    return pid


def _cleanup():
    for p in (PID_FILE, PCM_FILE):
        try:
            os.remove(p)
        except OSError:
            pass


def start_recording():
    os.makedirs(RUNTIME, exist_ok=True)
    f = open(PCM_FILE, "wb")
    p = subprocess.Popen(parec_cmd(), stdout=f, stderr=subprocess.DEVNULL,
                         start_new_session=True)  # survives this short-lived process
    with open(PID_FILE, "w") as pf:
        pf.write(str(p.pid))
    log("● recording (toggle again to stop)")
    notify("● Recording…")


def stop_and_type(pid):
    os.kill(pid, signal.SIGTERM)
    for _ in range(50):                    # wait up to ~1s for parec to exit & flush
        try:
            os.kill(pid, 0); time.sleep(0.02)
        except ProcessLookupError:
            break
    try:
        pcm = open(PCM_FILE, "rb").read()
    except OSError:
        pcm = b""
    _cleanup()
    log(f"■ captured {len(pcm)} bytes ({len(pcm)/(RATE*2):.1f}s), transcribing…")
    notify("■ Transcribing…")
    model, np = load_model()
    text = transcribe(model, np, pcm)
    if not text:
        log("(no speech)"); notify("(no speech)"); return
    log(f"→ {text!r}")
    try:
        ui = open_uinput()
    except Exception as ex:
        log(f"cannot open /dev/uinput ({ex}); run 'dictate-setup' + re-login.")
        return
    time.sleep(0.05)                       # let the compositor register the device
    type_text(ui, text)
    ui.close()


def do_toggle():
    require_parec()
    pid = recording_pid()
    if pid is None:
        start_recording()
    else:
        stop_and_type(pid)


# ---- GNOME custom shortcut wiring (user-level, no sudo) -------------------
def _gs_get(schema, key, path=None):
    tgt = f"{schema}:{path}" if path else schema
    return subprocess.run(["gsettings", "get", tgt, key],
                          capture_output=True, text=True).stdout.strip()


def _gs_set(schema, key, value, path=None):
    tgt = f"{schema}:{path}" if path else schema
    subprocess.run(["gsettings", "set", tgt, key, value], check=True)


def install_shortcut(binding):
    if not shutil.which("gsettings"):
        log("gsettings not found — is this a GNOME session?"); sys.exit(1)
    exe = os.path.realpath(shutil.which("dictate") or sys.argv[0])
    command = f"{exe} --toggle"
    base = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/"
    path = base + "dictate/"
    schema = "org.gnome.settings-daemon.plugins.media-keys"
    kb = schema + ".custom-keybinding"

    import ast
    raw = _gs_get(schema, "custom-keybindings")
    lst = [] if raw.startswith("@as") else ast.literal_eval(raw)
    if path not in lst:
        lst.append(path)
    _gs_set(schema, "custom-keybindings", str(lst))
    _gs_set(kb, "name", "Dictate toggle", path)
    _gs_set(kb, "command", command, path)
    _gs_set(kb, "binding", binding, path)
    log(f"bound {binding} -> {command}")
    log("Change it in Settings ▸ Keyboard ▸ Custom Shortcuts, or re-run with a new BINDING.")


def check():
    require_parec()
    try:
        ui = open_uinput(); ui.close()
    except Exception as ex:
        log(f"cannot open /dev/uinput ({ex}).")
        log("Run 'dictate-setup', then log out/in (or: newgrp uinput).")
        sys.exit(1)
    os.makedirs(RUNTIME, exist_ok=True)
    log(f"OK — /dev/uinput writable, parec present, runtime dir {RUNTIME} ok.")
    log("Bind a key with 'dictate --install-shortcut', then press it to start/stop.")


def self_test():
    require_parec()
    secs = float(os.environ.get("DICTATE_TEST_SECS", "5"))
    model, np = load_model()
    os.makedirs(RUNTIME, exist_ok=True)
    f = open(PCM_FILE, "wb")
    p = subprocess.Popen(parec_cmd(), stdout=f, stderr=subprocess.DEVNULL)
    log(f"● recording {secs:.0f}s — speak now…")
    time.sleep(secs)
    p.terminate()
    try:
        p.wait(timeout=1)
    except Exception:
        p.kill()
    f.close()
    pcm = open(PCM_FILE, "rb").read(); os.remove(PCM_FILE)
    log(f"■ captured {len(pcm)} bytes ({len(pcm)/(RATE*2):.1f}s), transcribing…")
    t0 = time.time()
    text = transcribe(model, np, pcm)
    log(f"transcribed in {time.time() - t0:.2f}s")
    print("\nTRANSCRIPT:", repr(text))


USAGE = """dictate — toggle-key local speech-to-text (Wayland/GNOME, CPU).

  dictate --toggle                     start/stop (bind this to a key)
  dictate --install-shortcut [BIND]    bind a GNOME key (default <Ctrl><Alt>d)
  dictate --check                      verify /dev/uinput + parec
  dictate --test                       record & print a transcript (no setup)

First-time setup:  dictate-setup  (sudo; dedicated 'uinput' group + udev rule)
Docs: ~/dotfiles/dictate/README.md
"""


def main():
    args = sys.argv[1:]
    if "--toggle" in args:
        do_toggle()
    elif "--test" in args:
        self_test()
    elif "--check" in args:
        check()
    elif "--install-shortcut" in args:
        rest = [a for a in args if a != "--install-shortcut"]
        binding = rest[0] if rest else os.environ.get("DICTATE_BINDING", "<Ctrl><Alt>d")
        install_shortcut(binding)
    else:
        print(USAGE)


if __name__ == "__main__":
    main()
