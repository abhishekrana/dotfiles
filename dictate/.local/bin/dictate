#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["faster-whisper", "numpy"]
# ///
"""
dictate - toggle-key local speech-to-text into tmux, CPU-only.

A GNOME shortcut runs `dictate --toggle`: first press records the mic, second
press transcribes locally with faster-whisper and types the text into your
active tmux pane via `tmux send-keys`. Runs entirely in userspace - no sudo, no
groups, no device access. The mic opens only while recording, during which other
audio output is muted so the mic can't pick up your speakers (DICTATE_DUCK=0 to
disable). Recording also
auto-stops after DICTATE_SILENCE seconds of trailing silence (or the DICTATE_MAXSECS
cap), so a second press is optional; set DICTATE_SILENCE=0 for manual-only.

Transcription runs in a lazy model server: the first dictation spawns a
background `dictate --serve` that loads the model once and keeps it resident, so
later dictations skip the ~1 s model-load. The server self-exits after
DICTATE_IDLE seconds of inactivity to free its RAM. If it can't be reached, the
toggle falls back to loading the model in-process.

Targeting: the transcript goes to the pane you're focused on if it runs Claude,
otherwise a `claude` pane in your current session, otherwise the most-recent
`claude` pane. Override with DICTATE_TMUX_TARGET (a pane id or session:win.pane).

Setup:
  dictate --install-shortcut     # bind Super+\\ and Super+Z to `dictate --toggle`
  dictate --check                # verify parec + tmux

Commands: run `dictate --help`. Env-var config (DICTATE_*): see dictate/README.md.
"""
import os, re, sys, time, signal, shutil, socket, subprocess

# whispercpp backend: whisper.cpp's own server, held resident by ours and spoken
# to over loopback. Installed by `./install.sh whisper-vulkan`.
WCPP_BIN   = os.environ.get("DICTATE_WHISPERCPP_BIN", os.path.expanduser("~/.local/bin/whisper-server"))
# small.en, not large-v3-turbo: measured on the same five clips, turbo was both
# slower (2205ms vs 792ms on 20s of audio) and no more accurate on the terms that
# matter. Point this at ggml-large-v3-turbo-q5_0.bin if a harder clip proves otherwise.
WCPP_MODEL = os.environ.get(
    "DICTATE_WHISPERCPP_MODEL",
    os.path.expanduser("~/.local/share/whisper-cpp/models/ggml-small.en-q8_0.bin"),
)
WCPP_PORT  = int(os.environ.get("DICTATE_WHISPERCPP_PORT", "8178"))

# Backend, resolved from what is installed rather than from the environment:
# dictation is launched by a GNOME shortcut and a tmux run-shell, and NEITHER
# sources ~/.bashrc.d - so an env var set there reaches the one path (a fresh
# interactive shell) that is used least. Having run `./install.sh whisper-vulkan`
# is the opt-in; DICTATE_BACKEND=faster-whisper still forces the CPU back.
BACKEND   = os.environ.get("DICTATE_BACKEND") or (
    "whispercpp" if os.path.exists(WCPP_BIN) and os.path.exists(WCPP_MODEL) else "faster-whisper"
)
MODEL     = os.environ.get("DICTATE_MODEL", "small.en")
COMPUTE   = os.environ.get("DICTATE_COMPUTE", "int8")
LANG      = os.environ.get("DICTATE_LANG", "en")
SOURCE    = os.environ.get("DICTATE_SOURCE", "")
BEAM      = int(os.environ.get("DICTATE_BEAM", "1"))
LATENCY   = os.environ.get("DICTATE_LATENCY", "50")  # ms; low so parec flushes promptly
TMUX_CMD  = os.environ.get("DICTATE_TMUX_CMD", "claude")
TMUX_TGT  = os.environ.get("DICTATE_TMUX_TARGET", "")
# Whisper reads this as the text preceding the clip, so listed words become far
# likelier to come out - which cuts both ways. Only add a term after hearing it
# fail, then re-run the sample clips: `worktree` and `dotfiles` earned their
# place ("work tree", ".files"), `origin/main` was tried and dropped (it pulled
# "diff pane" into "diff_main"), and `agentbar` was tried and dropped because
# prompting it did not stop "agent sidebar". `gitleaks` fixes "get leaks" but is
# left out by preference - and dropping it stopped the prompt deleting "radv".
#
# NOT alphabetical, deliberately: order changes the bias. Sorting this list
# turned "task check" into "taskcheck" and appended a stray "merge request",
# both of which the order below avoids. Proven-failing terms lead; the loosest
# term goes last.
PROMPT    = os.environ.get(
    "DICTATE_PROMPT",
    "Dictation for a coding terminal. Terms: worktree, git, dotfiles, tmux, issues, "
    "tickets, bugs, features, Claude Code, Python, JSON, API, YAML, merge request.",
)
RATE = 16000  # Whisper wants 16 kHz mono

RUNTIME  = os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/dictate-{os.getuid()}"
PCM_FILE = os.path.join(RUNTIME, "dictate.pcm")
PID_FILE = os.path.join(RUNTIME, "dictate.pid")
SOCK_FILE = os.path.join(RUNTIME, "dictate.sock")     # model-server socket
SRV_PID  = os.path.join(RUNTIME, "dictate-serve.pid")
WATCH_PID = os.path.join(RUNTIME, "dictate-watch.pid")
DUCK_FILE = os.path.join(RUNTIME, "dictate-duck")     # pre-mute sink state, held while recording
IDLE     = float(os.environ.get("DICTATE_IDLE", "300"))  # server self-exits after this idle
SILENCE  = float(os.environ.get("DICTATE_SILENCE", "2.0"))  # auto-stop after this much trailing silence (0 = off)
MAXSECS  = float(os.environ.get("DICTATE_MAXSECS", "120"))  # hard cap on one recording
VAD_RMS  = float(os.environ.get("DICTATE_VAD_RMS", "300"))  # int16 RMS above this counts as speech
DUCK     = os.environ.get("DICTATE_DUCK", "1").strip().lower()  # mute other audio while recording (0/off = don't)
CHUNK    = 65536
MIN_PCM  = int(RATE * 2 * 0.3)                         # < 0.3 s = stray tap, not speech



def log(*a):
    print("[dictate]", *a, file=sys.stderr, flush=True)


def trace(evt, **kv):
    # Fire-and-forget edge into the shared dotfiles trace log. dictate's stderr
    # log() is discarded in every real launch context (run-shell -b, GNOME
    # shortcut, serve/watch DEVNULL), so this is the only durable record.
    # Never call inside watch()/serve loops. Args go as argv (no shell); the CLI
    # escapes + caps values.
    try:
        subprocess.run(
            [os.path.expanduser("~/.local/bin/dotfiles-trace"), "log", "dictate", evt]
            + [f"{k}={v}" for k, v in kv.items()],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=1, check=False)
    except Exception:
        pass


def set_state(state):
    # drives the centred @dictate status segment: "rec" (red) | "work" (amber) | "" idle (grey)
    if state:
        tmux("set", "-g", "@dictate", state)
    else:
        tmux("set", "-gu", "@dictate")
    tmux("refresh-client", "-S")


def flash(msg):
    tmux("display-message", f"dictate: {msg}")


def require(cmd):
    if not shutil.which(cmd):
        log(f"{cmd} not found"); sys.exit(1)


# ---- pick the tmux pane to type into -------------------------------------
def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True)


def panes():
    fmt = "\t".join(["#{pane_id}", "#{pane_current_command}", "#{session_name}",
                     "#{window_active}", "#{pane_active}", "#{window_activity}"])
    r = tmux("list-panes", "-a", "-F", fmt)
    keys = ["id", "cmd", "session", "wactive", "pactive", "wactivity"]
    return [dict(zip(keys, line.split("\t")))
            for line in r.stdout.splitlines() if line.count("\t") == 5]


def active_session():
    """Session shown by the most-recently-active attached client."""
    r = tmux("list-clients", "-F", "#{client_activity}\t#{client_session}")
    rows = sorted((l.split("\t") for l in r.stdout.splitlines() if "\t" in l),
                  key=lambda x: int(x[0] or 0), reverse=True)
    return rows[0][1] if rows else None


def resolve_target():
    """(pane_id, label): the focused pane if it runs the app, else an app pane in
    the focused session, else the most-recently-active app pane anywhere."""
    if TMUX_TGT:
        return TMUX_TGT, TMUX_TGT
    ps = panes()
    if not ps:
        return None, None
    session = active_session()
    focused = next((p for p in ps if p["session"] == session
                    and p["wactive"] == "1" and p["pactive"] == "1"), None)
    if focused and focused["cmd"] == TMUX_CMD:
        return focused["id"], label(focused)
    for scope in (session, None):
        apps = [p for p in ps if p["cmd"] == TMUX_CMD
                and (scope is None or p["session"] == scope)]
        if apps:
            apps.sort(key=lambda p: int(p["wactivity"] or 0), reverse=True)
            return apps[0]["id"], label(apps[0])
    return (focused["id"], label(focused)) if focused else (None, None)


def label(p):
    return f"{p['id']} {p['session']} [{p['cmd']}]"


def send_to_tmux(target, text):
    # -l = literal text (not key names); -- guards text starting with '-'.
    return tmux("send-keys", "-t", target, "-l", "--", text).returncode == 0


def send_enter():
    # mouse "⏎ enter": press Enter in the pane a transcript would go to.
    target, lbl = resolve_target()
    if not target:
        log("no tmux pane found"); flash("no pane to submit")
        trace("send", kind="enter", ok=0); return
    tmux("send-keys", "-t", target, "Enter")
    log(f"⏎ → {lbl}")
    trace("send", kind="enter", ok=1)


def send_text(text):
    # mouse quick-phrase button (e.g. "commit and push"): type TEXT then Enter
    # into the same pane a transcript would go to. The short sleep lets the TUI
    # ingest the pasted text before Enter submits it.
    target, lbl = resolve_target()
    if not target:
        log("no tmux pane found"); flash("no pane to submit")
        trace("send", kind="text", ok=0, chars=len(text)); return
    send_to_tmux(target, text)
    time.sleep(0.12)
    tmux("send-keys", "-t", target, "Enter")
    log(f"{text!r} ⏎ → {lbl}")
    trace("send", kind="text", ok=1, chars=len(text))


# ---- transcription -------------------------------------------------------
def load_model():
    """Return (handle, np) for the configured backend - the shape serve() holds.

    The GPU is an optimisation, never a dependency: if whisper.cpp cannot start
    (driver gone, GPU disabled, model truncated, port wedged) this falls back to
    the CPU rather than failing the dictation. BACKEND only says what to TRY -
    every caller dispatches on the handle it gets back, so the fallback routes
    itself."""
    if BACKEND == "whispercpp":
        try:
            return load_whispercpp(), None
        except Exception as e:
            log(f"whispercpp unavailable ({e}) - falling back to the CPU")
            trace("fallback", to="faster-whisper", why=str(e)[:80])
    log(f"loading model {MODEL!r} (first run downloads it)…")
    from faster_whisper import WhisperModel
    import numpy as np
    t0 = time.time()
    model = WhisperModel(MODEL, device="cpu", compute_type=COMPUTE)
    log(f"model ready in {time.time() - t0:.1f}s")
    return model, np


def transcribe(model, np, pcm):
    if len(pcm) < MIN_PCM:  # < 0.3 s of audio
        return ""
    if is_whispercpp(model):               # the handle decides, not BACKEND
        return transcribe_whispercpp(model, pcm)
    audio = np.frombuffer(pcm, dtype=np.int16).astype(np.float32) / 32768.0
    # condition_on_previous_text=False + vad_filter are the anti-hallucination
    # flags for dictation; faster-whisper's default thresholds handle the rest.
    segments, _ = model.transcribe(
        audio, language=LANG, initial_prompt=PROMPT, beam_size=BEAM,
        vad_filter=True, condition_on_previous_text=False,
    )
    text = "".join(s.text for s in segments)
    return " ".join(text.split())  # collapse whitespace/newlines (never send Enter)


# ---- whispercpp backend (whisper.cpp on the GPU, via its own server) ------
# whisper.cpp has no in-process binding here, so the resident model lives in a
# `whisper-server` child that ours owns for its lifetime and posts each clip to
# over loopback. A per-call `whisper-cli` measured 410ms slower - process start
# plus Vulkan context setup, paid on every single dictation.
def is_whispercpp(model):
    """A whisper-server child, not a faster-whisper model. Asked of the handle
    rather than BACKEND, so a GPU->CPU fallback routes to the right code."""
    return hasattr(model, "port") and hasattr(model, "terminate")


def close_backend(model):
    """Terminate a whispercpp child; a no-op for faster-whisper's plain object.
    Every path that calls load_model() must call this - the child holds the GPU
    and a port, and outlives its parent otherwise."""
    if not is_whispercpp(model):
        return
    model.terminate()
    try:
        model.wait(timeout=5)
    except Exception:
        model.kill()


def port_taken(port):
    try:
        socket.create_connection(("127.0.0.1", port), 0.3).close()
        return True
    except OSError:
        return False


def load_whispercpp():
    for path, what in ((WCPP_BIN, "binary"), (WCPP_MODEL, "model")):
        if not os.path.exists(path):
            raise RuntimeError(f"whispercpp {what} missing: {path} (./install.sh whisper-vulkan)")
    # Never share a port. whisper-server sets SO_REUSEPORT, so a second one binds
    # happily alongside the first and the kernel hands each connection to either -
    # which silently transcribes with whichever model got there first. Take a port
    # nobody answers on, and the server we talk to is provably the one we started.
    port = next((p for p in range(WCPP_PORT, WCPP_PORT + 20) if not port_taken(p)), None)
    if port is None:
        raise RuntimeError(f"no free port in {WCPP_PORT}..{WCPP_PORT + 19}")
    if port != WCPP_PORT:
        log(f"note: :{WCPP_PORT} is busy (stale whisper-server?) - using :{port}")
    log(f"starting whisper-server on :{port} with {os.path.basename(WCPP_MODEL)}…")
    t0 = time.time()
    # -bs/-bo match DICTATE_BEAM and -nf drops temperature fallback, so one clip
    # is one pass; -nt is text only. Same knobs the faster-whisper path uses.
    proc = subprocess.Popen(
        [WCPP_BIN, "-m", WCPP_MODEL, "--host", "127.0.0.1", "--port", str(port),
         "-nt", "-nf", "-bs", str(BEAM), "-bo", str(BEAM)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    proc.port = port                               # what transcribe_whispercpp posts to
    deadline = time.time() + 60                    # cold start: model load + GPU upload
    while time.time() < deadline:
        if proc.poll() is not None:
            raise RuntimeError(f"whisper-server exited with {proc.returncode}")
        if port_taken(port):                       # ours, since it was free above
            log(f"whisper-server ready in {time.time() - t0:.1f}s")
            return proc
        time.sleep(0.1)
    proc.terminate()
    raise RuntimeError("whisper-server did not come up within 60s")


def wav_bytes(pcm):
    """Wrap raw 16 kHz mono s16le PCM in a WAV container - what the server takes."""
    import io, wave
    buf = io.BytesIO()
    with wave.open(buf, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(pcm)
    return buf.getvalue()


def transcribe_whispercpp(proc, pcm):
    """POST the clip to the resident server. The multipart body is built by hand
    so the script keeps its two PEP 723 deps and adds no HTTP library."""
    import urllib.request
    if proc.poll() is not None:                    # died since it was loaded
        raise RuntimeError(f"whisper-server gone (exit {proc.returncode})")
    bnd = "----dictate" + os.urandom(8).hex()
    parts = [
        f"--{bnd}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n".encode()
        for k, v in (("response_format", "text"), ("language", LANG), ("prompt", PROMPT))
    ]
    parts.append(f"--{bnd}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a.wav\""
                 f"\r\nContent-Type: audio/wav\r\n\r\n".encode())
    parts.append(wav_bytes(pcm) + f"\r\n--{bnd}--\r\n".encode())
    req = urllib.request.Request(
        f"http://127.0.0.1:{proc.port}/inference", data=b"".join(parts),
        headers={"Content-Type": f"multipart/form-data; boundary={bnd}"},
    )
    with urllib.request.urlopen(req, timeout=120) as r:
        text = r.read().decode("utf-8", "replace")
    # whisper.cpp narrates non-speech as [BLANK_AUDIO] / [SOUND] / (music); the
    # faster-whisper path returns "" for the same audio, and a stray toggle must
    # not type a token into the pane. Strip them, then let "" mean no speech.
    # [BLANK_AUDIO], [END], [SOUND], [_BEG_]… - the set is open-ended, so the rule
    # is shape, not a name list: SQUARE-bracketed all-caps is never speech (you
    # would say "open bracket"), while parentheses are dictated, so only the
    # known non-speech words are stripped there - "(dev mode)" survives.
    text = re.sub(r"\[[A-Z_][A-Z_ ]{1,24}\]", " ", text)
    text = re.sub(r"\((?:blank[_ ]audio|silence|music|sound|noise)\)", " ", text, flags=re.IGNORECASE)
    return " ".join(text.split())                  # collapse whitespace (never send Enter)


# ---- lazy model server (spawned on first use, self-exits when idle) ------
# The client (toggle-off) ships raw PCM over a Unix socket and reads back text,
# so it never imports faster-whisper. Connecting only succeeds once the server
# has finished loading the model - that doubles as the readiness signal.
def server_up():
    """True if a live server currently owns the socket."""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(1.0)
        s.connect(SOCK_FILE)
        s.close()
        return True
    except OSError:
        return False


def serve():
    """Load the model once, then transcribe PCM sent over SOCK_FILE until idle."""
    os.makedirs(RUNTIME, exist_ok=True)
    if server_up():
        log("server already running; exiting"); return
    if os.path.exists(SOCK_FILE):
        try: os.remove(SOCK_FILE)          # stale socket left by a crashed server
        except OSError: pass
    model, np = load_model()               # the expensive bit - paid once, here
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        srv.bind(SOCK_FILE)                # binding only now => connect == ready
    except OSError as e:                   # e.g. a racing server bound first
        log(f"bind failed ({e}) - exiting"); return
    srv.listen(8)
    srv.settimeout(IDLE)
    open(SRV_PID, "w").write(str(os.getpid()))

    def _bye(*_):
        close_backend(model)                   # must not outlive us: GPU + port
        for p in (SOCK_FILE, SRV_PID):
            try: os.remove(p)
            except OSError: pass
        sys.exit(0)
    signal.signal(signal.SIGTERM, _bye)
    signal.signal(signal.SIGINT, _bye)

    log(f"● serving on {SOCK_FILE} (idle-exit {IDLE:.0f}s)")
    try:
        while True:
            try:
                conn, _ = srv.accept()
            except socket.timeout:
                log("idle - exiting"); break
            try:                                     # one bad client must not kill the server
                conn.settimeout(30)
                with conn:
                    pcm = bytearray()
                    while (chunk := conn.recv(CHUNK)):   # client half-closes to signal EOF
                        pcm += chunk
                    if not pcm:                      # liveness probe (e.g. --check): nothing to send
                        continue
                    t0 = time.time()
                    text = transcribe(model, np, bytes(pcm))
                    log(f"{len(pcm)/(RATE*2):.1f}s -> {text!r} in {time.time()-t0:.2f}s")
                    conn.sendall(text.encode("utf-8"))
            except OSError as e:
                log(f"client error ({e}); continuing")
    finally:
        _bye()


def spawn_server():
    exe = os.path.realpath(shutil.which("dictate") or sys.argv[0])
    subprocess.Popen([exe, "--serve"], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def _connect():
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK_FILE)                   # raises OSError if no server is listening
    return s


def transcribe_via_server(pcm):
    """Send PCM to the server (spawning it if needed) and return the text.
    Returns None if the server can't be reached, so the caller can fall back.
    A single connection carries both the check and the request: try to connect,
    and only spawn a server if that fails - no separate liveness probe."""
    try:
        s = _connect()
    except OSError:
        log("no server - spawning one (this first dictation warms the model)…")
        spawn_server()
        s = None
        deadline = time.time() + 20        # cold start: model load + bind
        while time.time() < deadline:
            try:
                s = _connect(); break
            except OSError:
                time.sleep(0.1)
    if s is None:
        return None
    s.settimeout(60)
    with s:
        s.sendall(pcm)
        s.shutdown(socket.SHUT_WR)         # EOF tells the server the clip is complete
        buf = bytearray()
        while (chunk := s.recv(CHUNK)):
            buf += chunk
    return buf.decode("utf-8")


def serve_stop():
    try:
        pid = int(open(SRV_PID).read().strip())
        os.kill(pid, signal.SIGTERM)
        log(f"stopped model server (pid {pid})")
    except (OSError, ValueError):
        log("no running model server")


# ---- recording (detached parec -> temp file; daemonless toggle state) ----
def parec_cmd():
    cmd = ["parec", "--format=s16le", f"--rate={RATE}", "--channels=1",
           f"--latency-msec={LATENCY}"]
    if SOURCE:
        cmd.append(f"--device={SOURCE}")
    return cmd


# ---- duck other audio while recording (mute default sink, restore on stop) ----
def _pactl(*args):
    try:
        return subprocess.run(["pactl", *args], capture_output=True, text=True)
    except OSError:                            # no pactl → skip ducking, never block recording
        return None


def duck_mute():
    """Mute the default sink while recording. Saves prior state to DUCK_FILE so a
    crashed run can't strand the audio muted - the next recording restores it first."""
    if DUCK in ("0", "off", "no", "false", ""):
        return
    if not os.path.exists(DUCK_FILE):          # remember what to restore to (skip if a crash left one)
        r = _pactl("get-sink-mute", "@DEFAULT_SINK@")
        try:
            open(DUCK_FILE, "w").write("1" if (r and "yes" in r.stdout) else "0")
        except OSError:
            return
    _pactl("set-sink-mute", "@DEFAULT_SINK@", "1")


def unduck():
    """Restore the default sink's pre-recording mute state (no-op if never ducked)."""
    try:
        prior = open(DUCK_FILE).read().strip() or "0"
    except OSError:
        return
    _pactl("set-sink-mute", "@DEFAULT_SINK@", prior)
    try:
        os.remove(DUCK_FILE)
    except OSError:
        pass


def cleanup():
    for p in (PID_FILE, PCM_FILE, WATCH_PID):
        try:
            os.remove(p)
        except OSError:
            pass


def recording_pid():
    try:
        pid = int(open(PID_FILE).read().strip())
        if open(f"/proc/{pid}/comm").read().strip() == "parec":
            return pid
    except (OSError, ValueError):
        pass
    cleanup()
    return None


def start_recording():
    os.makedirs(RUNTIME, exist_ok=True)
    duck_mute()                                # silence other audio so the mic hears only you
    f = open(PCM_FILE, "wb")
    p = subprocess.Popen(parec_cmd(), stdout=f, stderr=subprocess.DEVNULL,
                         start_new_session=True)  # survives this short-lived process
    open(PID_FILE, "w").write(str(p.pid))
    set_state("rec")
    trace("rec", action="start")
    if SILENCE > 0:                            # spawn the silence watcher (auto-stop)
        exe = os.path.realpath(shutil.which("dictate") or sys.argv[0])
        subprocess.Popen([exe, "--watch", str(p.pid)], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        log(f"● recording (auto-stops after {SILENCE:.0f}s silence; toggle to stop)")
    else:
        log("● recording (toggle again to stop)")


def stop_and_send(pid):
    set_state("work")                          # amber: mic stopping, then transcribing
    t_start = time.time()
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    try:
        for _ in range(50):                    # wait up to ~1s for parec to exit & flush
            try:
                os.kill(pid, 0); time.sleep(0.02)
            except ProcessLookupError:
                break
        try:
            pcm = open(PCM_FILE, "rb").read()
        except OSError:
            pcm = b""
        cleanup()
        unduck()                                  # parec is dead + PCM captured -> mic closed,
                                                  # buffer frozen: restore audio now, not after
                                                  # the slow transcribe. Removes DUCK_FILE, so
                                                  # every path below is already unmuted.
        if len(pcm) < MIN_PCM:                    # stray tap - don't wake the server
            log("(no speech)"); flash("no speech")
            trace("result", outcome="no-speech"); return
        log(f"■ captured {len(pcm)/(RATE*2):.1f}s, transcribing…")
        trace("transcribe", secs=round(len(pcm)/(RATE*2), 1))
        try:
            text = transcribe_via_server(pcm)
        except Exception as e:
            log(f"server path failed ({e!r}); using in-process"); text = None
        if text is None:                          # server unreachable → in-process
            model, np = load_model()
            try:
                text = transcribe(model, np, pcm)
            finally:
                close_backend(model)
        if not text:
            log("(no speech)"); flash("no speech")
            trace("result", outcome="empty", ms=int((time.time() - t_start) * 1000)); return
        target, lbl = resolve_target()
        if not target:
            log(f"no tmux pane found; transcript: {text!r}")
            flash("no tmux pane found")
            trace("result", outcome="no-pane", chars=len(text)); return
        log(f"→ {lbl}: {text!r}")
        ok = send_to_tmux(target, text)
        if not ok:
            log("tmux send-keys failed"); flash("send-keys failed")
        trace("result", outcome=("sent" if ok else "send-failed"),
              chars=len(text), ms=int((time.time() - t_start) * 1000))
    finally:
        set_state("")                          # back to idle grey, whatever happened


# ---- silence watcher (auto-stop) -----------------------------------------
def watch_pid():
    try:
        wpid = int(open(WATCH_PID).read().strip())
        if "--watch" in open(f"/proc/{wpid}/cmdline").read():
            return wpid
    except (OSError, ValueError):
        pass
    return None


def watch(pid):
    """Auto-stop the parec recording after trailing silence (post-speech) or the cap."""
    import numpy as np
    open(WATCH_PID, "w").write(str(os.getpid()))
    stop = []
    signal.signal(signal.SIGTERM, lambda *_: stop.append(1))   # manual toggle-stop
    signal.signal(signal.SIGINT, lambda *_: stop.append(1))
    start = last_voice = time.time()
    voiced = False
    posn = 0
    try:
        while not stop:
            time.sleep(0.15)
            try:
                alive = open(f"/proc/{pid}/comm").read().strip() == "parec"
            except OSError:
                alive = False
            if not alive:
                break                          # parec ended/crashed - finalise what we have
            try:
                with open(PCM_FILE, "rb") as fh:
                    fh.seek(posn); data = fh.read()
            except OSError:
                data = b""
            # Advance by whole s16le frames: a read can land mid-sample, and
            # skipping that byte puts every later read out of phase.
            n = len(data) // 2 * 2
            posn += n
            if n and np.sqrt(np.mean(np.frombuffer(data[:n], dtype=np.int16).astype(np.float32) ** 2)) >= VAD_RMS:
                voiced = True; last_voice = time.time()
            now = time.time()
            if (voiced and now - last_voice >= SILENCE) or (now - start >= MAXSECS):
                break
        stop_and_send(pid)
    finally:
        try: os.remove(WATCH_PID)
        except OSError: pass


def toggle():
    require("parec")
    pid = recording_pid()
    if not pid:
        trace("toggle", branch="start")
        start_recording(); return
    wpid = watch_pid()
    if wpid:
        trace("toggle", branch="stop-watch")
        os.kill(wpid, signal.SIGTERM)          # let the watcher finalise (one stopper, no double-send)
    else:
        trace("toggle", branch="stop")
        stop_and_send(pid)


# ---- GNOME custom shortcut (user-level, no sudo) -------------------------
DEFAULT_BINDINGS = ["<Super>backslash", "<Super>z"]


def install_shortcut(bindings):
    require("gsettings")
    import ast
    bindings = bindings or DEFAULT_BINDINGS
    exe = os.path.realpath(shutil.which("dictate") or sys.argv[0])
    cmd = f"{exe} --toggle"
    base = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/"
    schema = "org.gnome.settings-daemon.plugins.media-keys"

    raw = subprocess.run(["gsettings", "get", schema, "custom-keybindings"],
                         capture_output=True, text=True).stdout.strip()
    lst = [] if raw.startswith("@as") else ast.literal_eval(raw)
    keep = [p for p in lst if not p.rstrip("/").rsplit("/", 1)[-1].startswith("dictate")]
    ours = []
    for i, b in enumerate(bindings):
        path = base + ("dictate" if i == 0 else f"dictate-{i}") + "/"
        ours.append(path)
        kb = f"{schema}.custom-keybinding:{path}"
        for key, val in (("name", f"Dictate toggle {b}"), ("command", cmd), ("binding", b)):
            subprocess.run(["gsettings", "set", kb, key, val], check=True)
    subprocess.run(["gsettings", "set", schema, "custom-keybindings", str(keep + ours)], check=True)
    log(f"bound {' + '.join(bindings)} -> {cmd}")
    log("Change these in Settings ▸ Keyboard ▸ Custom Shortcuts.")


# ---- checks --------------------------------------------------------------
def check():
    require("parec"); require("tmux")
    if not panes():
        log("tmux has no panes - start tmux first."); sys.exit(1)
    _, lbl = resolve_target()
    log(f"OK - parec + tmux present. Transcript would go to: {lbl}")
    log(f"model server: {'up' if server_up() else 'down (spawns on first dictation)'}")
    if BACKEND == "whispercpp":
        # Report the pieces before a dictation needs them: a missing binary or
        # model only surfaces mid-transcribe otherwise, with the mic already shut.
        for path, what in ((WCPP_BIN, "binary"), (WCPP_MODEL, "model")):
            log(f"whispercpp {what}: {path} {'✓' if os.path.exists(path) else '✗ MISSING'}")
        if not (os.path.exists(WCPP_BIN) and os.path.exists(WCPP_MODEL)):
            log("run ./install.sh whisper-vulkan")
    else:
        log(f"backend: {BACKEND} ({MODEL}, {COMPUTE}, cpu)")


def self_test():
    require("parec")
    secs = float(os.environ.get("DICTATE_TEST_SECS", "5"))
    model, np = load_model()
    os.makedirs(RUNTIME, exist_ok=True)
    f = open(PCM_FILE, "wb")
    p = subprocess.Popen(parec_cmd(), stdout=f, stderr=subprocess.DEVNULL)
    log(f"● recording {secs:.0f}s - speak now…")
    time.sleep(secs)
    p.terminate()
    try:
        p.wait(timeout=1)
    except Exception:
        p.kill()
    f.close()
    pcm = open(PCM_FILE, "rb").read(); os.remove(PCM_FILE)
    log("■ transcribing…")
    t0 = time.time()
    try:
        text = transcribe(model, np, pcm)
    finally:
        close_backend(model)                       # serve()'s _bye() is not in play here
    ms = int((time.time() - t0) * 1000)
    # --test is how backends get compared, so it reports its own cost. The name
    # comes from the handle, not BACKEND: after a GPU->CPU fallback the global
    # still says whispercpp, and a benchmark that mislabels itself is worse than
    # none. The toggle path's `result` trace never fires here, so this one does.
    used = "whispercpp" if is_whispercpp(model) else "faster-whisper"
    trace("result", outcome="test", backend=used, chars=len(text), ms=ms)
    print(f"\nTRANSCRIPT: {text!r}\n  {used}, {ms} ms for {len(pcm)/(RATE*2):.1f}s of audio")


USAGE = """dictate - toggle-key local speech-to-text into tmux (local, zero privilege).

  dictate --toggle                     start/stop (bind this to a key)
  dictate --target                     show which pane the transcript goes to
  dictate --install-shortcut [KEYS…]   bind GNOME keys (default <Super>backslash + <Super>z)
  dictate --check                      verify parec + tmux, report server state
  dictate --test                       record & print a transcript, with its backend and ms
  dictate --serve-stop                 stop the model server (to pick up new config)

Docs: ~/dotfiles/dictate/README.md
"""


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--toggle":
        toggle()
    elif arg == "--target":
        require("tmux"); print(resolve_target()[1] or "(no tmux target found)")
    elif arg == "--send":
        require("tmux"); send_enter()
    elif arg == "--type":
        require("tmux"); send_text(sys.argv[2] if len(sys.argv) > 2 else "")
    elif arg == "--test":
        self_test()
    elif arg == "--serve":
        serve()
    elif arg == "--serve-stop":
        serve_stop()
    elif arg == "--watch":
        watch(int(sys.argv[2]))
    elif arg == "--check":
        check()
    elif arg == "--install-shortcut":
        install_shortcut(sys.argv[2:])
    else:
        print(USAGE)


if __name__ == "__main__":
    main()
