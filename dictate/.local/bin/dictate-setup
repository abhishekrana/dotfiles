#!/usr/bin/env bash
# One-time permission setup for `dictate` on Wayland.
#
# Grants write access to /dev/uinput (needed to type the transcript) via a
# DEDICATED 'uinput' group — NOT the broad 'input' group. dictate never reads
# /dev/input (the trigger is a GNOME shortcut), so no keyboard-read/keylogger
# access is granted. The only capability handed out is keystroke injection.
#
# Not run by bootstrap.sh: it changes your security posture and needs a
# re-login, so it is opt-in per machine. Idempotent — safe to re-run.
set -euo pipefail

RULE=/etc/udev/rules.d/99-uinput-dictate.rules

echo "==> ensure dedicated 'uinput' group exists and you're a member"
sudo groupadd -f uinput
if id -nG "$USER" | tr ' ' '\n' | grep -qx uinput; then
  echo "    already in 'uinput'"
else
  sudo usermod -aG uinput "$USER"
  echo "    added $USER to 'uinput'  (re-login or 'newgrp uinput' to activate)"
fi

echo "==> udev rule: /dev/uinput -> group uinput, mode 0660"
echo 'KERNEL=="uinput", GROUP="uinput", MODE="0660", OPTIONS+="static_node=uinput"' \
  | sudo tee "$RULE" >/dev/null

echo "==> load the uinput module now and at every boot"
echo uinput | sudo tee /etc/modules-load.d/uinput.conf >/dev/null
sudo modprobe uinput

echo "==> reload udev"
sudo udevadm control --reload-rules
sudo udevadm trigger

echo
echo "Done."
echo "If you were just added to 'uinput', activate it with either:"
echo "    newgrp uinput     # this shell only, good enough to test"
echo "  or log out and back in (activates it everywhere)."
echo
echo "Then:  dictate --install-shortcut   # bind a key"
echo "       dictate --check              # verify"
