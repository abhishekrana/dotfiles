{
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "bash $HOME/.claude/hooks/on-notification.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "[ -x \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" ] && \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" hook || true",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "[ -x \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" ] && \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" hook || true",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash $HOME/.claude/hooks/on-pre-tool-use.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "[ -x \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" ] && \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" hook || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash $HOME/.claude/hooks/on-session-end.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "[ -x \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" ] && \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" hook || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "[ -x \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" ] && \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" hook || true",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash $HOME/.claude/hooks/on-stop.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "[ -x \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" ] && \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" hook || true",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "[ -x \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" ] && \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" hook || true",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "[ -x \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" ] && \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" hook || true",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash $HOME/.claude/hooks/on-prompt-submit.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "[ -x \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" ] && \"$HOME/.tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar\" hook || true",
            "type": "command"
          }
        ]
      }
    ]
  },
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "bash $HOME/.claude/statusline-command.sh",
    "type": "command"
  }
}
