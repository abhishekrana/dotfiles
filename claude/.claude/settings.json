  "model": "opus[1m]",
  "hooks": {
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/statusline-workdir.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/slack-post-gate.sh\" ] && bash \"$HOME/.claude/slack-post-gate.sh\" || exit 0"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh",
    "refreshInterval": 1
  },
  "footerLinksRegexes": [],
  "subagentStatusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "notion-workspace-plugin@notion-plugin-marketplace": true,
    "slack@claude-plugins-official": true,
    "animore@animore-agents": true
  },
  "extraKnownMarketplaces": {
    "notion-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "makenotion/claude-code-notion-plugin"
      }
    },
    "animore-agents": {
      "source": {
        "source": "directory",
        "path": "/home/abhishek-rana/workspaces/agents"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "light",
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true
}
