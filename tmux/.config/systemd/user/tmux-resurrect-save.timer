[Unit]
Description=Periodically save tmux session state (tmux-resurrect)

[Timer]
# First save shortly after boot, then every 15 min (matches continuum's default).
OnBootSec=3min
OnUnitActiveSec=15min
# If the machine was off/asleep when a run was due, save at the next opportunity.
Persistent=true

[Install]
WantedBy=timers.target
