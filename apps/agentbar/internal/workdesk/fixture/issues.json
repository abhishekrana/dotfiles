  {
    "iid": "128",
    "title": "Registry lookups are slow on cold start",
    "updatedAt": "2026-08-24T10:00:00Z",
    "webUrl": "https://gitlab.example.com/acme/platform/-/issues/128",
    "labels": {
      "nodes": [
        {
          "title": "prio::high"
        },
        {
          "title": "type::bug"
        }
      ]
    },
    "id": "gid://gitlab/Issue/9128",
    "status": {
      "id": "gid://gitlab/WorkItems::Statuses::Custom::Status/2",
      "name": "To do",
      "category": "to_do"
    },
    "iteration": {
      "id": "gid://gitlab/Iteration/7",
      "title": "",
      "startDate": "2026-08-24",
      "dueDate": "2026-09-06",
      "iterationCadence": {
        "title": "Fortnightly"
      }
    },
    "description": "Cold start walks the whole registry before the first request is served.\n\nThe lookup is O(n) over every entry and the cache is only populated on the second\nrequest, so the first one after a deploy pays for all of them.\n\n- [ ] index the registry by name at load\n- [ ] warm the cache on boot",
    "assignees": {
      "nodes": [
        {
          "username": "you"
        }
      ]
    },
    "discussions": {
      "nodes": [
        {
          "resolved": false,
          "notes": {
            "nodes": [
              {
                "body": "Reproduced on a cold pod: 4.2s to first byte, 40ms after that.",
                "system": false,
                "author": {
                  "username": "dana"
                }
              },
              {
                "body": "assigned to @you",
                "system": true,
                "author": {
                  "username": "gitlab"
                }
              },
              {
                "body": "Warming on boot moves the cost rather than removing it - can we index instead?",
                "system": false,
                "author": {
                  "username": "you"
                }
              }
            ]
          }
        }
      ]
    }
  },
