#!/usr/bin/env bash
# theme - re-skin the terminal environment from ~/dotfiles/design/palette.toml.
#
# Usage:
#   theme                 print the current flavor
#   theme --list          list the supported flavors
#   theme <flavor>        switch everything to <flavor>
#
# Flavors: solarized-light (default) · solarized-dark · catppuccin-latte · catppuccin-mocha
# v1 drives the sidebar (@agentbar-theme) and ghostty (built-in themes); the tmux
# frame, fzf and the port-dependent tools land in later increments.
set -euo pipefail

PALETTE="${THEME_PALETTE:-$HOME/dotfiles/design/palette.toml}"
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/theme"

FLAVORS="solarized-light solarized-dark catppuccin-latte catppuccin-mocha"

# ghostty's built-in theme name per flavor (from `ghostty +list-themes`).
ghostty_name() {
    case "$1" in
        solarized-light) echo "iTerm2 Solarized Light" ;;
        solarized-dark) echo "iTerm2 Solarized Dark" ;;
        catppuccin-latte) echo "Catppuccin Latte" ;;
        catppuccin-mocha) echo "Catppuccin Mocha" ;;
    esac
}

# palette_get <flavor> <token> - read one hex from palette.toml's [themes.<flavor>] table.
palette_get() {
    awk -v want="[themes.$1]" -v key="$2" '
		/^\[/ { in_s = ($0 == want) }
		in_s && $1 == key { gsub(/"/, "", $3); print $3; exit }
	' "$PALETTE"
}

valid() { case " $FLAVORS " in *" $1 "*) return 0 ;; *) return 1 ;; esac }

# The sidebar reads @agentbar-theme at launch; running instances need a restart.
apply_sidebar() {
    command -v tmux >/dev/null || return 0
    tmux set -g @agentbar-theme "$1" 2>/dev/null || true
}

# Ghostty applies a built-in theme by name. Write it to a non-repo file that the main
# config includes (config-file = ?~/.config/theme/ghostty.conf), so switching never edits
# the tracked config. SIGUSR2 reloads a running instance (Linux).
apply_ghostty() {
    printf 'theme = %s\n' "$(ghostty_name "$1")" >"$STATE_DIR/ghostty.conf"
    pkill -USR2 -x ghostty 2>/dev/null || true
}

# The tmux frame hardcodes colors that overpaint ghostty inside tmux; regenerate the
# colour-carrying settings from the palette and source them into the running server.
apply_tmux() {
    command -v tmux >/dev/null || return 0
    local f="$STATE_DIR/tmux.conf"
    local bg surface fg muted accent block ask grn work
    bg=$(palette_get "$1" bg)
    surface=$(palette_get "$1" surface)
    fg=$(palette_get "$1" fg)
    muted=$(palette_get "$1" muted)
    accent=$(palette_get "$1" accent)
    block=$(palette_get "$1" blocked)
    ask=$(palette_get "$1" asking)
    grn=$(palette_get "$1" "done")
    work=$(palette_get "$1" working)
    # Built here, not inline in the heredoc, to keep the source under 120 columns;
    # the generated line is byte-identical either way.
    # One space of padding inside every chip and one between them, so the row's
    # gaps are all the same three columns. Keep it that way when editing labels.
    #
    # Each chip colours only when @dictate_src names it (set by the script from the
    # chip you clicked). Colour is the only feedback a status bar has, so it must
    # say WHICH button is working - never key two chips off one state.
    local dseg dsend
    dchip() { # dchip <src> <label> -> a chip that reacts only to its own source
        local mine="#{==:#{@dictate_src},$1}"
        printf '#{?#{&&:%s,#{==:#{@dictate},rec}},#[fg=%s bg=%s]%s,' "$mine" "$block" "$surface" "$2"
        printf '#{?#{&&:%s,#{==:#{@dictate},work}},#[fg=%s bg=%s]%s,' "$mine" "$ask" "$surface" "$2"
        printf '#[fg=%s bg=%s]%s}}' "$muted" "$surface" "$2"
    }
    dseg=$(dchip dictate " ● dictate ")
    dsend=$(dchip dictsend " ● dictate+send ")
    # Diff chip: violet normally, amber when the agent is writing in another
    # worktree (@diff_drift, set in .tmux.conf). Same width either way.
    local diffseg
    diffseg="#{?#{E:@diff_drift},#[fg=$ask bg=$surface bold],#[fg=#6c71c4 bg=$surface]}"
    diffseg="$diffseg ◧ changes "
    # Session badge: red while the prefix is pending. A chip that appears instead
    # would shift every segment right of it (see .tmux.conf).
    local left
    left="#{@host_badge}#{?client_prefix,#[fg=$bg bg=$block bold],#[fg=$bg bg=$accent bold]}"
    left="$left #S #[fg=$fg bg=$surface] "
    # Rails: one rule for every pane - folder + branch on the left, and where
    # Claude is writing on the right when that pane runs it. Both zones in the
    # accent, so the rail reads as chrome instead of blending into the log
    # scrolling under it. Each zone is given the pane's width and its share of
    # it, so the branch is cut only when the pane has no room (see .tmux.conf).
    local border rail
    rail="#($HOME/.local/bin/tmux-rail.sh '#{pane_current_path}' '#{pane_width}'"
    rail="$rail '#{?#{E:@rail_agent},2,1}')"
    border="#{?#{==:#{pane_current_command},agentbar},,"
    border="$border #[fg=$accent]$rail "
    border="$border#{?#{E:@rail_agent},#[align=right fg=$accent]→ "
    border="$border#($HOME/.local/bin/tmux-rail.sh '#{@agent_workdir}' '#{pane_width}' 2) , }}"
    cat >"$f" <<EOF
set -g status-style "fg=$fg,bg=$surface"
set -g window-style "fg=$fg,bg=$bg"
set -g window-active-style "fg=$fg,bg=$bg"
set -g pane-border-style "fg=$muted,bg=$bg"
set -g pane-active-border-style "fg=$accent,bg=$bg"
set -g status-left "$left"
set -g window-status-current-format "#[fg=$bg,bg=$accent,bold] #I:#W#{?window_zoomed_flag, Z,} "
set -g window-status-format "#{?window_bell_flag,#[fg=$bg bg=$block bold],#[fg=$muted bg=$surface]} #I:#W "
set -g @dictate_seg "$dseg"
set -g @dictsend_seg "$dsend"
set -g @submit_seg "#{?@submit_flash,#[fg=$bg bg=$grn] ⏎ send ,#[fg=$work bg=$surface] ⏎ send }"
set -g @push_seg "#{?@push_flash,#[fg=$bg bg=$grn] ⇡ commit+push ,#[fg=$accent bg=$surface] ⇡ commit+push }"
set -g @diff_seg "$diffseg"
set -g pane-border-format "$border"
EOF
    tmux source-file "$f" 2>/dev/null || true
}

# fzf reads its palette from FZF_DEFAULT_OPTS; write the flavor's --color block to a
# file that fzf.bash sources, so new shells follow the flavor.
apply_fzf() {
    local f="$STATE_DIR/fzf.sh"
    local mode bg fg accent emph sel muted work grn border
    mode=$(palette_get "$1" mode)
    bg=$(palette_get "$1" bg)
    fg=$(palette_get "$1" fg)
    accent=$(palette_get "$1" accent)
    emph=$(palette_get "$1" emphasis)
    sel=$(palette_get "$1" selection)
    muted=$(palette_get "$1" muted)
    work=$(palette_get "$1" working)
    emph=$(palette_get "$1" emphasis)
    grn=$(palette_get "$1" "done")
    border=$(palette_get "$1" border)
    cat >"$f" <<EOF
_fzf_color="--color=$mode --color=fg:$fg,bg:$bg,hl:$accent"
_fzf_color+=" --color=fg+:$emph,bg+:$sel,hl+:$accent"
_fzf_color+=" --color=info:$muted,prompt:$accent,pointer:$accent"
_fzf_color+=" --color=marker:$grn,spinner:$work,header:$muted"
_fzf_color+=" --color=border:$border,gutter:$bg"
EOF
}

# Env-driven tools (bat via BAT_THEME, leaf via LEAF_THEME, and anything reading $THEME)
# inherit the flavor from a file sourced by ~/.bashrc.d/theme.bash, so new shells follow
# it. Catppuccin bat themes need installing separately; until then bat falls back
# harmlessly.
#
# leaf is the opposite case to yazi: it ships no Catppuccin, so those flavors get its
# closest light/dark built-in instead. Every flavor must map to a theme leaf knows, and
# the failure is silent rather than loud: an unrecognised LEAF_THEME does not error, leaf
# falls back to its own default (ocean, a DARK theme) and ignores the config's `theme`
# setting entirely - so an unmapped flavor here would quietly paint dark on a light
# terminal. (The `--theme` flag is the strict path: it exits 1 on an unknown name.)
# solarized-light is not a leaf built-in; it is registered under that name in
# leaf/.config/leaf/config.toml.
apply_env() {
    local f="$STATE_DIR/env.sh"
    local bat leaf
    case "$1" in
        solarized-light) bat="Solarized (light)" leaf="solarized-light" ;;
        solarized-dark) bat="Solarized (dark)" leaf="solarized-dark" ;;
        catppuccin-latte) bat="Catppuccin Latte" leaf="arctic" ;;
        catppuccin-mocha) bat="Catppuccin Mocha" leaf="ocean" ;;
    esac
    cat >"$f" <<EOF
export THEME="$1"
export BAT_THEME="$bat"
export LEAF_THEME="$leaf"
EOF
}

# delta reads its colors from git config; write the flavor's block to a file git includes
# (overrides the solarized-light default). Non-repo, applies on the next git diff.
apply_delta() {
    local f="$STATE_DIR/delta.gitconfig"
    local light stheme add rem
    case "$1" in
        solarized-light) light=true stheme="Solarized (light)" ;;
        solarized-dark) light=false stheme="Solarized (dark)" ;;
        catppuccin-latte) light=true stheme="Catppuccin Latte" ;;
        catppuccin-mocha) light=false stheme="Catppuccin Mocha" ;;
    esac
    add=$(palette_get "$1" add)
    rem=$(palette_get "$1" remove)
    cat >"$f" <<EOF
[delta]
	light = $light
	syntax-theme = $stheme
	plus-style = syntax "$add"
	plus-emph-style = syntax bold "$add"
	minus-style = syntax "$rem"
	minus-emph-style = syntax bold "$rem"
EOF
}

# The tmux session popup renders the agent-state language in shell (the picker's rows
# and its preview), so the four state colors and the popup's own fzf palette come from
# here instead of being pinned in those scripts. Sourced when the popup opens, so a
# switch lands the next time you press Alt-;.
apply_agent_state() {
    local f="$STATE_DIR/agent-state.sh"
    local bg accent emph muted border block ask work grn
    bg=$(palette_get "$1" bg)
    accent=$(palette_get "$1" accent)
    emph=$(palette_get "$1" emphasis)
    muted=$(palette_get "$1" muted)
    border=$(palette_get "$1" border)
    block=$(palette_get "$1" blocked)
    ask=$(palette_get "$1" asking)
    work=$(palette_get "$1" working)
    emph=$(palette_get "$1" emphasis)
    grn=$(palette_get "$1" "done")
    # The popup's selected row is a solid accent bar (bg+/fg+), deliberately louder than
    # the shell fzf's subtle selection in fzf.sh; gutter/pointer stay off.
    local sel="bg+:$accent,fg+:$bg,gutter:-1,pointer:-1,hl:$accent,hl+:$bg"
    cat >"$f" <<EOF
_state_blocked="$block"
_state_asking="$ask"
_state_working="$work"
_state_done="$grn"
_state_muted="$muted"
_popup_fzf_color="$sel,border:$border,info:$muted,prompt:$emph"
EOF
}

# nvim reads the flavor at startup from ~/.config/theme/nvim.lua (colorscheme + background).
apply_nvim() {
    local scheme bg
    case "$1" in
        solarized-light) scheme=solarized bg=light ;;
        solarized-dark) scheme=solarized bg=dark ;;
        catppuccin-latte) scheme=catppuccin-latte bg=light ;;
        catppuccin-mocha) scheme=catppuccin-mocha bg=dark ;;
    esac
    cat >"$STATE_DIR/nvim.lua" <<EOF
return { colorscheme = "$scheme", background = "$bg" }
EOF
}

main() {
    case "${1:-}" in
        --list | -l)
            echo "$FLAVORS" | tr ' ' '\n'
            return 0
            ;;
        "")
            if [ -f "$STATE_DIR/current" ]; then cat "$STATE_DIR/current"; else echo "solarized-light (default)"; fi
            return 0
            ;;
    esac
    local flavor="$1"
    if ! valid "$flavor"; then
        echo "theme: unknown flavor '$flavor' (try: theme --list)" >&2
        return 2
    fi
    mkdir -p "$STATE_DIR"
    echo "$flavor" >"$STATE_DIR/current"
    apply_sidebar "$flavor"
    apply_ghostty "$flavor"
    apply_tmux "$flavor"
    apply_fzf "$flavor"
    apply_agent_state "$flavor"
    apply_env "$flavor"
    apply_delta "$flavor"
    apply_nvim "$flavor"
    local msg accent
    accent=$(palette_get "$flavor" accent)
    msg="→ $flavor (accent $accent)."
    msg="$msg Ghostty + tmux reload now; new shells pick up fzf/bat;"
    msg="$msg next git diff / nvim launch / Alt-; popup picks up delta / nvim / popup;"
    echo "$msg restart sidebars with prefix+e twice."
}

main "$@"
